# source 'echo "$( pw=$( secret-tool lookup user tigrisor domain nxp.com ); echo set imap_pass=\"$pw\"; echo set smtp_pass=\"$pw\" )" |'

# set ssl_force_tls = no
# set ssl_starttls = no
set ssl_force_tls = yes

set display_filter="unsanitize-safelinks"
set editor ="ls -la %s && unsanitize-safelinks -i %s && vim %s"
set mailcap_path = ~/.mutt/mailcap-work

unmailboxes *
named-mailboxes "Inbox" "=inbox"
named-mailboxes "Seen" "=inbox/Seen"
named-mailboxes "Sent" "=Sent"
named-mailboxes "Sent Items" "=Sent Items"
named-mailboxes "Review" "=inbox/Review"
named-mailboxes "Drafts" "=Drafts"
named-mailboxes "Trash" "=Trash"
named-mailboxes "LnxRevLi" "=inbox/Mailing lists/LnxRevLi"
named-mailboxes "nipa-drm" "=inbox/nipa/drm-next"
named-mailboxes "nipa-linux-next" "=inbox/nipa/linux-next"
named-mailboxes "nipa-net-next" "=inbox/nipa/net-next"

# S      = message (or tagged set) -> Seen
# Alt-s  = whole thread (e.g. a patch series + replies) -> Seen
# Alt-S  = everything read and not flagged -> Seen  ("I've skimmed it, clear the rest")
# $      = write changes, then push to server / pull new mail
macro index,pager S   "<save-message>=inbox/Seen<enter>" "move to Seen"
macro index       \es "<untag-pattern>~A<enter><tag-thread><tag-prefix><save-message>=inbox/Seen<enter>" "thread to Seen"
macro index       \eS "<tag-pattern>~R !~F<enter><tag-prefix><save-message>=inbox/Seen<enter>" "read+unflagged to Seen"
macro index       $   "<sync-mailbox><shell-escape>mbsync -qq 'work-inbox:INBOX,INBOX/Seen,Deleted Items'<enter>" "sync + mbsync"
